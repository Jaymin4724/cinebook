      "seed": 2127334298,
      "version": 608,
      "versionNonce": 960130182,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783946132661,
      "link": null,
      "locked": false,
      "text": "Super Admin Flow : \nPOST -> auth/login   -> payload=email + pass -> access token + refresh tokens + role\n\nTHEATRE ADMINS MANAGEMENT \nCRUD\n\nTHEATRE MANAGEMENT \nCRUD\n\nMOVIES \nCRUD\n\nSHOWS \nCRUD\n\nSCREENS \nCRUD \n\nUSER MANAGEMENT \nCRUD",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Super Admin Flow : \nPOST -> auth/login   -> payload=email + pass -> access token + refresh tokens + role\n\nTHEATRE ADMINS MANAGEMENT \nCRUD\n\nTHEATRE MANAGEMENT \nCRUD\n\nMOVIES \nCRUD\n\nSHOWS \nCRUD\n\nSCREENS \nCRUD \n\nUSER MANAGEMENT \nCRUD",
      "autoResize": true,
      "lineHeight": 1.25
    },
