    {
      "id": "eFsPKGpv1-BvaWuEMtO4C",
      "type": "text",
      "x": -6811.168560773915,
      "y": -6773.654531127124,
      "width": 2776.9013709449273,
      "height": 2200.0296475977166,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nyXMqDwddL1iBM9aclk7W"
      ],
      "frameId": null,
      "index": "b5w",
      "roundness": null,
      "seed": 2047135066,
      "version": 2146,
      "versionNonce": 1947875674,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783946132661,
      "link": null,
      "locked": false,
      "text": "Date: 9th April 2026\nThings to do : \n\nseat booking flow\nseat reserve -> store in redis -> payment -> seat booked\n\nshow/{show_id} (payload: seats to reserver in an array) => lock seats in redis for 15 minutes => seat unlock or seat book\n\n----------------------------------------------------------------------------------------------------\nwhat will user do before picking up the show ?\n----------------------------------------------------------------------------------------------------\nuser will search for movies or theatres -> global search api\n----------------------------------------------------------------------------------------------------\nuser will click on the movie or theatre\nif movie     -> all list of theatres where this movie is streaming (get theatres by movie id)\n\"/movie/{movie_id}/theatres\" ( distinct theatres ) \n\nif theatre  -> all list of movies that this theatre is streaming (get movies by theatre id)\n\"/theatre/{theatre_id}/movies\" ( distinct movies ) \n----------------------------------------------------------------------------------------------------\nwhen i go to any particular movie / when i go to any particular theatre \n\n/theatre/{theatre_id}/movie/{movie_id} => list of shows\n/movie/{movie_id}/theatre/{theatre_id} => list of shows\n----------------------------------------------------------------------------------------------------\nwhen you choose particular show \n\nGET show/{show_id} => screen layout  \n----------------------------------------------------------------------------------------------------\nwhen you choose tickets \nPOST show/{show_id}/seat-lock\npayload = {seat numbers array} => reserved seats for 15 minutes\n----------------------------------------------------------------------------------------------------\nBook tickets ( after payment ) \nPOST show/{show_id}/seat-book\npayload = {booked seats} => mark seats booked\n----------------------------------------------------------------------------------------------------\nflow completed",
      "fontSize": 46.316413633636145,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Date: 9th April 2026\nThings to do : \n\nseat booking flow\nseat reserve -> store in redis -> payment -> seat booked\n\nshow/{show_id} (payload: seats to reserver in an array) => lock seats in redis for 15 minutes => seat unlock or seat book\n\n----------------------------------------------------------------------------------------------------\nwhat will user do before picking up the show ?\n----------------------------------------------------------------------------------------------------\nuser will search for movies or theatres -> global search api\n----------------------------------------------------------------------------------------------------\nuser will click on the movie or theatre\nif movie     -> all list of theatres where this movie is streaming (get theatres by movie id)\n\"/movie/{movie_id}/theatres\" ( distinct theatres ) \n\nif theatre  -> all list of movies that this theatre is streaming (get movies by theatre id)\n\"/theatre/{theatre_id}/movies\" ( distinct movies ) \n----------------------------------------------------------------------------------------------------\nwhen i go to any particular movie / when i go to any particular theatre \n\n/theatre/{theatre_id}/movie/{movie_id} => list of shows\n/movie/{movie_id}/theatre/{theatre_id} => list of shows\n----------------------------------------------------------------------------------------------------\nwhen you choose particular show \n\nGET show/{show_id} => screen layout  \n----------------------------------------------------------------------------------------------------\nwhen you choose tickets \nPOST show/{show_id}/seat-lock\npayload = {seat numbers array} => reserved seats for 15 minutes\n----------------------------------------------------------------------------------------------------\nBook tickets ( after payment ) \nPOST show/{show_id}/seat-book\npayload = {booked seats} => mark seats booked\n----------------------------------------------------------------------------------------------------\nflow completed",
      "autoResize": true,
      "lineHeight": 1.25
    },
