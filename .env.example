# Copy this file to .env and fill in real values (local / non-Docker setup).
# .env is gitignored — never commit real secrets.
# Hostnames here point at localhost; use .env.docker.example for the Docker setup.

# --- Database (point at your local Postgres) ---
DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/cinebook
TEST_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/cinebook-tests

# --- JWT (use long random strings; e.g. `openssl rand -base64 32`) ---
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET_ACCESS_KEY=change-me-access-secret
JWT_SECRET_REFRESH_KEY=change-me-refresh-secret
JWT_ALGORITHM=HS256

# --- Google OAuth (from Google Cloud Console; only needed for Google login) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Redis (point at your local Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Mail (Gmail address + App Password to send OTP/ticket emails) ---
MAIL_USERNAME=you@example.com
MAIL_FROM=you@example.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# --- OMDb (free key from https://www.omdbapi.com/apikey.aspx) ---
OMDB_API_KEY=your-omdb-key

# --- Elasticsearch (point at your local ES) ---
ES_URL=http://localhost:9200

# --- Data encryption (Fernet key derivation) ---
ENCRYPTION_PASSWORD=change-me-encryption-password
ENCRYPTION_STATIC_SALT=change-me-encryption-salt

# --- Environment: TESTING disables rate limiting; use anything else in prod ---
ENV=DEVELOPMENT
